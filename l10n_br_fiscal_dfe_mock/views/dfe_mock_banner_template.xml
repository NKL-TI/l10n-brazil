<odoo>
    <!--
        Extends the base DF-e banner (rendered by
        l10n_br_fiscal_dfe/controllers/main.py) instead of using a separate
        controller, so the mock actions live where the rest of the DF-e
        actions already are.
    -->
    <template
        id="dfe_mock_banner_extension"
        inherit_id="l10n_br_fiscal_dfe.dfe_document_banner"
        name="DF-e Mock Mode Extensions"
    >
        <xpath expr="//div[hasclass('mb-3')]" position="inside">
            <a
                type="action"
                role="button"
                data-model="res.company"
                data-method="action_banner_toggle_dfe_mock_mode"
                data-reload-on-close="true"
                t-attf-class="btn ms-2 #{'btn-warning' if company.dfe_mock_mode else 'btn-outline-secondary'}"
                title="Toggle DF-e Mock Mode for this company"
            >
                <i class="fa fa-flask" />
                <t t-if="company.dfe_mock_mode"> Disable Mock Mode</t>
                <t t-else=""> Enable Mock Mode</t>
            </a>
            <a
                type="action"
                role="button"
                data-model="res.company"
                data-method="action_banner_reset_dfe_cooldown"
                data-reload-on-close="true"
                class="btn btn-outline-secondary ms-2"
                title="Clear the DF-e query cooldown so the next query can run immediately"
            >
                <i class="fa fa-refresh" /> Reset Query Cooldown
            </a>
        </xpath>

        <xpath expr="//t[@t-if='inactivity_warning']" position="after">
            <t t-if="company.dfe_mock_mode">
                <div class="alert alert-warning d-flex align-items-center mb-3">
                    <i class="fa fa-flask me-2 fs-4" />
                    <span>
                        <b>MOCK MODE ATIVO</b>
                        — Consultas DF-e estão sendo respondidas pelo pool
                        local, sem comunicação com a SEFAZ.
                    </span>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
